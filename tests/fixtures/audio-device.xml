<!-- Captured verbatim from a real Roku ECP /query/audio-device reply. -->
<audio-device>
	<capabilities>
		<all-destinations>wifi-remote,datagram,headphones,arc,speakers,spdif,lineout</all-destinations>
	</capabilities>
	<global>
		<muted>true</muted>
		<volume>17</volume>
		<destination-list>speakers,spdif,lineout</destination-list>
	</global>
	<destinations>
		<destination name="speakers">
			<muted>false</muted>
			<volume>45</volume>
		</destination>
		<destination name="spdif">
			<muted>false</muted>
			<volume>100</volume>
		</destination>
	</destinations>
</audio-device>
