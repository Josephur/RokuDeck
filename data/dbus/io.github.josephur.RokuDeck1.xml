<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- SPDX-License-Identifier: GPL-3.0-or-later -->
  <interface name="io.github.josephur.RokuDeck1">
    <annotation name="io.github.josephur.RokuDeck1.Error.UnknownDevice" value="exitCode=4"/>
    <annotation name="io.github.josephur.RokuDeck1.Error.UnsupportedCommand" value="exitCode=5"/>
    <annotation name="io.github.josephur.RokuDeck1.Error.UnsupportedCapability" value="exitCode=5"/>
    <annotation name="io.github.josephur.RokuDeck1.Error.SafetyRejected" value="exitCode=6"/>
    <annotation name="io.github.josephur.RokuDeck1.Error.Timeout" value="exitCode=7"/>
    <annotation name="io.github.josephur.RokuDeck1.Error.TransportFailure" value="exitCode=7"/>
    <annotation name="io.github.josephur.RokuDeck1.Error.InvalidRule" value="exitCode=8"/>
    <annotation name="io.github.josephur.RokuDeck1.Error.UnknownRule" value="exitCode=9"/>
    <method name="ListDevices">
      <arg direction="out" type="s" name="devicesJson"/>
    </method>
    <method name="GetSnapshot">
      <arg direction="in" type="s" name="serial"/>
      <arg direction="out" type="s" name="snapshotJson"/>
    </method>
    <method name="RegisterClient">
      <arg direction="in" type="s" name="clientId"/>
      <arg direction="in" type="as" name="serials"/>
      <arg direction="in" type="u" name="intervalMs"/>
    </method>
    <method name="UpdateClientInterest">
      <arg direction="in" type="s" name="clientId"/>
      <arg direction="in" type="as" name="serials"/>
      <arg direction="in" type="u" name="intervalMs"/>
    </method>
    <method name="UnregisterClient">
      <arg direction="in" type="s" name="clientId"/>
    </method>
    <method name="DiscoverDevices">
      <arg direction="out" type="s" name="devicesJson"/>
    </method>
    <method name="AddDevice">
      <arg direction="in" type="s" name="deviceJson"/>
      <arg direction="out" type="s" name="deviceJson"/>
    </method>
    <method name="UpdateDevice">
      <arg direction="in" type="s" name="serial"/>
      <arg direction="in" type="s" name="changesJson"/>
      <arg direction="out" type="s" name="deviceJson"/>
    </method>
    <method name="RemoveDevice">
      <arg direction="in" type="s" name="serial"/>
    </method>
    <method name="SetDeviceOrder">
      <arg direction="in" type="as" name="serials"/>
    </method>
    <method name="TestDevice">
      <arg direction="in" type="s" name="address"/>
      <arg direction="out" type="s" name="snapshotJson"/>
    </method>
    <method name="SendCommand">
      <arg direction="in" type="s" name="serial"/>
      <arg direction="in" type="s" name="commandJson"/>
      <arg direction="out" type="s" name="requestId"/>
    </method>
    <signal name="DeviceSnapshotChanged">
      <arg type="s" name="serial"/>
      <arg type="s" name="snapshotJson"/>
    </signal>
    <signal name="DeviceListChanged">
      <arg type="s" name="devicesJson"/>
    </signal>
    <signal name="CommandFinished">
      <arg type="s" name="requestId"/>
      <arg type="s" name="resultJson"/>
    </signal>
    <method name="ListRules">
      <arg direction="out" type="s" name="rulesJson"/>
    </method>
    <method name="AddRule">
      <arg direction="in" type="s" name="ruleJson"/>
      <arg direction="out" type="s" name="ruleJson"/>
    </method>
    <method name="UpdateRule">
      <arg direction="in" type="s" name="ruleJson"/>
    </method>
    <method name="DeleteRule">
      <arg direction="in" type="s" name="ruleId"/>
    </method>
    <method name="SetRuleEnabled">
      <arg direction="in" type="s" name="ruleId"/>
      <arg direction="in" type="b" name="enabled"/>
    </method>
    <signal name="RulesChanged">
      <arg type="s" name="rulesJson"/>
    </signal>
  </interface>
</node>
